# Required for the `anthropic` LLM provider (the default).
# Alternatively run `ant auth login` and leave this unset -- the SDK picks up the profile.
ANTHROPIC_API_KEY=

# Only needed if you set embedder = "voyage:voyage-3" in ragcite.toml
VOYAGE_API_KEY=

# Any config key can be overridden from the environment with a RAGCITE_ prefix:
# RAGCITE_EMBEDDER=hash:512
# RAGCITE_MODEL=claude-opus-5
# RAGCITE_TOP_K=8
